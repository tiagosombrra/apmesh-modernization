        "content": "#include <sanitizer/asan_interface.h>\n#include <cstddef>\n#include <cstdio>\n#include <memory>\n#include <string>\n\nint ReadCell(const int*, std::size_t);\n\nint main(int argc, char** argv) {\n  static_assert(_MSVC_LANG == 201703L);\n  if (argc != 2)\n    return 2;\n  const std::string mode = argv[1];\n  if (mode != \"release\" && mode != \"expired-access\")\n    return 2;\n  auto cells = std::unique_ptr<int[]>(new int[4]);\n  cells[1] = 47;\n  int* observer = cells.get();\n  if (__asan_address_is_poisoned(observer) != 0 || ReadCell(observer, 1) != 47)\n    return 3;\n  cells.reset();\n  if (__asan_address_is_poisoned(observer) == 0)\n    return 4;\n  std::printf(\"asan_control mode=%s language=%ld iterator=%d live=1 retired=1\\n\",\n              mode.c_str(), static_cast<long>(_MSVC_LANG), _ITERATOR_DEBUG_LEVEL);\n  std::fflush(stdout);\n  if (mode == \"expired-access\") {\n    // Deliberately invalid: the matching instrument must report this actual read.\n    volatile int expired = ReadCell(observer, 1);\n    return expired == 47 ? 5 : 6;\n  }\n  std::puts(\"asan_control release_complete=1\");\n  return 0;\n}\n"
      },
