{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apmesh.example/schema/real_patch_v1.schema.json",
  "title": "Explicit but unverified source patch metadata",
  "description": "Scientific source claims are not automatically qualified by this format. Mesh Studio must verify provenance separately.",
  "type": "object", "additionalProperties": true,
  "required": ["schema", "synthetic", "obj_sha256", "source_model_sha256", "generator_commit", "patches", "nodes", "faces"],
  "properties": {
    "schema": {"const": "apmesh.meshstudio.real_patch.v1"},
    "synthetic": {"const": false},
    "obj_sha256": {"type":"string", "pattern":"^[0-9a-f]{64}$"},
    "source_model_sha256": {"type":"string", "pattern":"^[0-9a-f]{64}$"},
    "generator_commit": {"type":"string", "pattern":"^[0-9a-f]{40}$"},
    "patches": {"type":"array", "minItems":1, "maxItems":1024,
      "items":{"type":"object", "required":["patch_id","source_surface_id"], "properties":{"patch_id":{"type":"string"},"source_surface_id":{"type":"string"}}}},
    "nodes":{"type":"array"}, "faces":{"type":"array"}, "curves":{"type":"array"}
  }
}
