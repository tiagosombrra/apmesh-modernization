PROJECT_NAME = "APMesh Modernization"
OUTPUT_DIRECTORY = build/doxygen
INPUT = include src docs/API_CONTRACTS.md
USE_MDFILE_AS_MAINPAGE = docs/API_CONTRACTS.md
FILE_PATTERNS = *.h *.hpp *.cpp *.md
RECURSIVE = YES
EXCLUDE_PATTERNS = */libs/* */build/*
EXTRACT_ALL = NO
WARN_IF_UNDOCUMENTED = YES
WARN_IF_DOC_ERROR = YES
WARN_AS_ERROR = FAIL_ON_WARNINGS
GENERATE_HTML = YES
GENERATE_LATEX = NO
HAVE_DOT = NO
QUIET = YES
